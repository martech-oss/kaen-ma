    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.6",
    "vitest": "^4.0.17",
    "wrangler": "^4.115.0"
  }
