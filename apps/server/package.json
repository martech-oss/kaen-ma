{
  "name": "@kaenma/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:types": "wrangler types --env-interface ServerBindings",
    "db:migrate:local": "wrangler d1 migrations apply kaenma --local --persist-to ../client/.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply kaenma --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@kaenma/channels": "workspace:*",
    "@kaenma/core": "workspace:*",
    "@kaenma/database": "workspace:*",
    "@kaenma/content-renderer": "workspace:*",
    "@kaenma/orpc": "workspace:*",
    "@orpc/openapi": "1.14.13",
    "@orpc/server": "^1.14.13",
    "@orpc/zod": "1.14.13",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "postal-mime": "^2.7.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@orpc/client": "1.14.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17",
    "wrangler": "^4.114.0"
  }
}
