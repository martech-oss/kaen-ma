{
  "name": "kaenma",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native open source marketing automation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "dev": "pnpm db:migrate:local && pnpm --filter @kaenma/server dev",
    "dev:client": "pnpm --filter @kaenma/client dev",
    "deploy": "pnpm --filter @kaenma/server deploy",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test --passWithNoTests",
    "cf:types": "pnpm --filter @kaenma/server cf:types",
    "db:generate": "pnpm --filter @kaenma/database db:generate",
    "db:migrate:local": "pnpm --filter @kaenma/server db:migrate:local",
    "db:migrate:remote": "pnpm --filter @kaenma/server db:migrate:remote"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
